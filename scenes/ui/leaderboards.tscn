score_list = NodePath("MarginContainer/VBoxContainer/ScrollContainer/ScoreList")

[node name="BackendClient" type="Node" parent="."]
script = ExtResource("2_backend")

[node name="ColorRect" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
