[node name="DisplayHeader" type="Label" parent="MarginContainer/VBoxContainer/ScrollContainer/Sections"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Display"

[node name="DisplayPanel" type="PanelContainer" parent="MarginContainer/VBoxContainer/ScrollContainer/Sections"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="MarginContainer/VBoxContainer/ScrollContainer/Sections/DisplayPanel"]
